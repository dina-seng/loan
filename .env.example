# ── Required ────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (API only, never exposed to the browser).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_ledger?schema=public"

# Separate database used by `npm run test:api`. Must exist and be migrated.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_ledger_test?schema=public"

# Secret used to sign/protect sessions. Generate with: openssl rand -base64 48
# Must be at least 32 characters in production.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Public URLs. CLIENT_URL is also the allowed CORS origin (comma-separate for multiple).
CLIENT_URL="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"
API_URL="http://localhost:4000"

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Local business dates use this timezone for "today" and period boundaries.
BUSINESS_TIME_ZONE=Asia/Phnom_Penh

# Cookie behaviour. In production with a separate frontend domain set:
# COOKIE_SECURE=true and COOKIE_SAME_SITE=none (HTTPS required).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=7

# Login throttling (per IP + username).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# ── Seed (dev only) ─────────────────────────────────────────────────────
# Used by `npm run prisma:seed`. Change before first production use.
SEED_USERNAME=dad
SEED_PASSWORD=change-me-123

# ── Frontend ────────────────────────────────────────────────────────────
# In dev the Vite proxy forwards /api to the API, so this can stay empty.
# When deploying the frontend separately, set it to the API origin.
VITE_API_URL=
