// Business Ledger — Prisma schema
// All money is stored as BIGINT in KHR (khmer riel). Never use floats for money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MEMBER
}

enum PaymentDirection {
  OUDOM_TO_DAD
  DAD_TO_OUDOM
}

enum ClosingStatus {
  ACTIVE
  REOPENED
}

enum SettlementStatus {
  PARTIAL
  FULL
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  displayName  String
  role         UserRole  @default(MEMBER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions             Session[]
  lendingTransactions  LendingTransaction[]  @relation("LendingCreatedBy")
  deliveries           ProductDelivery[]     @relation("DeliveryCreatedBy")
  payments             Payment[]             @relation("PaymentCreatedBy")
  settlements          Settlement[]          @relation("SettlementCreatedBy")
  periodClosings       PeriodClosing[]       @relation("ClosingCreatedBy")
  auditLogs            AuditLog[]
  voidedLendings       LendingTransaction[]  @relation("LendingVoidedBy")
  voidedDeliveries     ProductDelivery[]     @relation("DeliveryVoidedBy")
  voidedPayments       Payment[]             @relation("PaymentVoidedBy")
  idempotencyKeys      IdempotencyKey[]
}

model AccountSettings {
  id            String   @id @default("main")
  businessName  String   @default("Business Ledger")
  ownerName     String   @default("ប៉ា")
  partnerName   String   @default("អ៊ូដុំ")
  openingBalance BigInt  @default(0)
  openingDate   DateTime @db.Date
  updatedAt     DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model IdempotencyKey {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  key        String
  scope      String
  result     Json
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, scope])
  @@index([expiresAt])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  unit        String
  description String?
  unitPrice   BigInt   @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveryItems DeliveryItem[]

  @@index([name])
}

model LendingTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String?   @unique
  transactionDate DateTime @db.Date
  amount       BigInt
  note         String?
  createdById  String    @db.Uuid
  voidedAt     DateTime?
  voidedById   String?   @db.Uuid
  voidReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy User  @relation("LendingCreatedBy", fields: [createdById], references: [id])
  voidedBy  User? @relation("LendingVoidedBy", fields: [voidedById], references: [id])

  @@index([transactionDate])
  @@index([voidedAt])
  @@index([createdById])
}

model ProductDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique
  deliveryDate DateTime  @db.Date
  note         String?
  totalAmount  BigInt
  createdById  String    @db.Uuid
  voidedAt     DateTime?
  voidedById   String?   @db.Uuid
  voidReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items     DeliveryItem[]
  createdBy User           @relation("DeliveryCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?          @relation("DeliveryVoidedBy", fields: [voidedById], references: [id])

  @@index([deliveryDate])
  @@index([voidedAt])
  @@index([createdById])
}

model DeliveryItem {
  id                 String  @id @default(uuid()) @db.Uuid
  deliveryId         String  @db.Uuid
  productId          String  @db.Uuid
  productNameSnapshot String
  unit               String
  quantity           Decimal @db.Decimal(18, 3)
  unitPrice          BigInt
  lineTotal          BigInt
  sortOrder          Int     @default(0)

  delivery ProductDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([productId])
}

model Payment {
  id          String           @id @default(uuid()) @db.Uuid
  reference   String?          @unique
  paymentDate DateTime         @db.Date
  direction   PaymentDirection
  amount      BigInt
  method      String           @default("cash")
  note        String?
  settlementId String?         @db.Uuid
  createdById String           @db.Uuid
  voidedAt    DateTime?
  voidedById  String?          @db.Uuid
  voidReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User       @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?      @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([paymentDate])
  @@index([voidedAt])
  @@index([direction])
  @@index([settlementId])
}

model Settlement {
  id             String           @id @default(uuid()) @db.Uuid
  reference      String?          @unique
  periodClosingId String?         @db.Uuid
  amount         BigInt
  direction      PaymentDirection
  method         String           @default("cash")
  note           String?
  status         SettlementStatus @default(PARTIAL)
  balanceAfter   BigInt
  createdById    String           @db.Uuid
  createdAt      DateTime         @default(now())

  periodClosing PeriodClosing? @relation(fields: [periodClosingId], references: [id])
  createdBy     User           @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  payments      Payment[]

  @@index([periodClosingId])
  @@index([createdAt])
}

model PeriodClosing {
  id             String        @id @default(uuid()) @db.Uuid
  closingKey     String?       @unique
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  closedAt       DateTime      @default(now())
  closedById     String        @db.Uuid
  status         ClosingStatus @default(ACTIVE)
  openingBalance BigInt
  totalLent      BigInt
  totalDelivered BigInt
  totalReceived  BigInt
  totalPaidOut   BigInt
  settlementAmount BigInt      @default(0)
  closingBalance BigInt
  note           String?
  snapshot       Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  closedBy    User         @relation("ClosingCreatedBy", fields: [closedById], references: [id])
  settlements Settlement[]

  @@index([periodStart, periodEnd])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}
