{
  "name": "business-ledger",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first, Khmer-first business ledger for Dad and Oudom",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "prisma:deploy": "dotenv -e .env -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "prisma:seed": "dotenv -e .env -- node apps/api/prisma/seed.js",
    "build": "npm run prisma:generate && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "lint": "eslint .",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "qa:pages": "node scripts/qa-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "playwright-core": "^1.65.1",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
